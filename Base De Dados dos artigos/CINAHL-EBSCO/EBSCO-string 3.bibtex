 keywords  = "Medical prescriptions; Placebos; Drug efficacy; Physicians; Decision making; Offices of Physicians (except Mental Health Specialists); Offices of physicians",
 pages     = "48-50",
 note      = "",
}

@article{4007710920250303,
 abstract  = "<b>Background:</b> The perceptions of practicing physicians regarding the current situation and appropriateness of shared decision-making (SDM) in life-sustaining treatment (LST) are of essential importance. The objective of this study is to investigate the clinical practice patterns and barriers to this process in China. <b>Methods:</b> A cross-sectional survey of physicians in China was conducted to assess perceived practices of SDM in LST. The survey instrument was developed through the Delphi method. Descriptive analyses and an exploratory factor analysis were performed to explore the correlations of factors. <b>Results:</b> We polled 977 physicians, of whom 971 completed the survey and 834 (85.9%) have experience of decision-making conversations for LST and entered the final analysis. Physicians expressed that in the process of doctor-patient communication, over-expectations of disease prognosis (778 [93.3%]), lack of general medical knowledge (716 [85.9%]), and negative emotiona",
 author    = "Liang, Yang and Zhang, Hua and Li, Shu and Ma, Qingbian",
 number    = "5",
 title     = "Shared Decision-Making on Life-Sustaining Treatment: A Survey of Current Barriers in Practice Among Clinicians Across China.",
 volume    = "13",
 url       = "https://research.ebsco.com/plink/be9f6f91-1668-31ae-90ea-53801632ef3f",
 year      = "2025",
