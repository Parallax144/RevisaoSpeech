}

@article{3808999020231124,
 abstract  = "Background Intercultural communication between physicians and patients is a prominent challenge faced by health sectors. This integrative review aims to explore and summarize the current literature examining the cultural factors impacting the communication experience of patients and physicians in healthcare settings and provide an evidence-based solution. Methods We used Whittemore and Knafl's (2005) approach to conduct this integrated review of the literature. Primary research studies meeting the search criteria were accessed from Medline/PubMed, Embassy, CINAHL, PsycInfo, ProQuest, Scopus, Web of Science, and Cochrane Review. We included studies published in English from 2008 to 2022. A total of 1731 studies were identified, of which 34 articles were included in this review. Results The findings revealed a difference in physicians' communicative behaviour when encountering patients from different cultural backgrounds compared to encounters with patients from the same cultural backgr",
 author    = "Alkhamees, Mohammad and Alasqah, Ibrahim",
 number    = "12",
 title     = "Patient-physician communication in intercultural settings: An integrative review.",
 volume    = "9",
 url       = "https://research.ebsco.com/plink/7b2373cd-9a69-3f5a-a95e-9e2144da55e2",
 year      = "2023",
 issn      = "2405-8440; Print",
 journal   = "Heliyon",
 keywords  = "",
 pages     = "e22667-null",
 note      = "",
}

@article{3715513120230701,
 abstract  = "Purpose of Review The implementation of shared decision-making (SDM) in acute pain services (APS) is still in its infancies especially when compared to other medical fields. Recent Findings Emerging evidence fosters the value of SDM in various acute care settings. We provide an overview of general SDM practices and possible advantages of incorporating such concepts in APS, point out barriers to SDM in this setting, present common patient decisions aids developed for APS and discuss opportunities for further development. Especially in the APS setting, patient-centred care is a key component for optimal patient outcome. SDM could be included into everyday clinical practice by using structured approaches such as the "seek, help, assess, reach, evaluate" (SHARE) approach, the 3 "MAking Good decisions In Collaboration"(MAGIC) questions, the "Benefits, Risks, Alternatives and doing Nothing"(BRAN) tool or the "the multifocal approach to sharing in shared decision-making"(MAPPIN'SDM) as guida",
 author    = "Bello, Corina M and Mackert, Simone and Harnik, Michael A and Filipovic, Mark G and Urman, Richard D and Luedi, Markus M",
 number    = "7",
 title     = "Shared Decision-Making in Acute Pain Services.",
 volume    = "27",
 url       = "https://research.ebsco.com/plink/fb8c9115-f752-3d59-82a1-86385cbfb615",
 year      = "2023",
 issn      = "1534-3081; Electronic",
 journal   = "Current pain and headache reports",
 keywords  = "Pain Clinics; Patient Participation; Humans; Patient-Centered Care",
 pages     = "193-202",
 note      = "",
}

@article{15884591120220801,
 abstract  = "A paradigm shift is underway in the patient-clinician relationship, driven by irreversible changes in information access, yet the model under which clinicians are trained, care is conducted, and care delivery is designed has not changed significantly even though we call it "patient centered." Humanity endured centuries in which even doctors had little idea what the patient's problem really was. Science slowly solved that, and for a century, only doctors could know what was worth knowing. Today, the rise of the internet and digital health has led to the end of that era. We are already witnessing early signs of the era of participatory health: genuinely empowered people living their lives and managing their health according to their own priorities, in partnership and consultation with physicians as needed. This may feel like a threat to the physician's sacred role, but it is no more so than when physicians adopted informed consent and then shared decision-making. In the 2010s, many phar",
 author    = "Meskó, Bertalan and deBronkart, Dave",
 number    = "8",
 title     = "Patient Design: The Importance of Including Patients in Designing Health Care.",
 volume    = "24",
 url       = "https://research.ebsco.com/plink/2b00661f-25a4-36fd-96b5-a631ace109bb",
 year      = "2022",
 issn      = "1439-4456",
 journal   = "Journal of Medical Internet Research",
 keywords  = "Medical care; Informed consent (Medical law); Physicians; Offices of Physicians (except Mental Health Specialists); Offices of physicians",
 pages     = "N.PAG-N.PAG",
 note      = "",
}

@article{4672242920091201,
 abstract  = "In this article, the author argues the assumption that placebo prescriptions are missed opportunities for doctor-patient communication. It proposes four alternative and approaches for physicians who consider placebo prescriptions through brief examples including acknowledge uncertainty, invite shared decision-making, and discuss non-pharmacologic treatments. It ends that the four proposals allows physician to find important opportunities to heal and diagnose and heal their patients.",
